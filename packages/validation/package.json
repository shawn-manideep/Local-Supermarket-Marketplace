{
  "name": "@workspace/validation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./vendor-profile": {
      "types": "./dist/vendor-profile.d.ts",
      "import": "./dist/vendor-profile.js",
      "default": "./dist/vendor-profile.js"
    },
    "./variant-formatting": {
      "types": "./dist/variant-formatting.d.ts",
      "import": "./dist/variant-formatting.js",
      "default": "./dist/variant-formatting.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}