{
  "name": "@workspace/localization",
  "description": "Customer-only English/Telugu localization foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --tsconfig tsconfig.json --test test/*.test.ts*"
  },
  "peerDependencies": {
    "react": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-test-renderer": "19.1.0",
    "react": "catalog:",
    "react-test-renderer": "19.1.0",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  }
}
