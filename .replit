modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Marketplace Development"

[[workflows.workflow]]
name = "Marketplace Development"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/marketplace-dashboard: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/marketplace-customer: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/mockup-sandbox: Component Preview Server"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.development]
SUPABASE_ANON_KEY = "sb_publishable_olHk9WQVRmzGF05yQB4bSA_YQzZRbE2"
SUPABASE_URL = "https://gkwcolipeavxnuzqlamb.supabase.co"

