modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Phase 12 Dashboard Preview"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Phase 12 Backend API"

[[workflows.workflow]]
name = "Phase 12 Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "CORS_ALLOWED_ORIGINS=https://$REPLIT_EXPO_DEV_DOMAIN pnpm --filter @workspace/api run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Phase 12 Dashboard Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "VITE_SUPABASE_URL=$SUPABASE_URL VITE_SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY pnpm --filter @workspace/dashboard run dev -- --port 5173"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Phase 12 Customer Web Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "rm -rf /tmp/phase12-customer-web && EXPO_PUBLIC_SUPABASE_URL=$SUPABASE_URL EXPO_PUBLIC_SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY pnpm --filter @workspace/customer exec expo export --platform web --output-dir /tmp/phase12-customer-web && PORT=8082 node scripts/src/customer-web-preview.mjs /tmp/phase12-customer-web"
waitForPort = 8082

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
