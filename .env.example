# Public/client-safe Supabase configuration.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Expo client-safe aliases used by the customer application.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=

# Server-only Supabase database connection string.
# This contains database credentials and must never reach browser or Expo code.
SUPABASE_DB_URL=

# Server-only key for future controlled administrative Supabase operations.
# Do not expose this to customer or dashboard clients.
SUPABASE_SERVICE_ROLE_KEY=